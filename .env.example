# Wajib. Kunci rahasia; isi yang SAMA di menu Pengaturan Sistem > WA Gateway pada aplikasi.
# Buat yang panjang dan acak (contoh: openssl rand -hex 32)
API_KEY=ganti-dengan-kunci-acak-yang-panjang

# Folder penyimpanan sesi WhatsApp. Di Coolify, pasang Persistent Storage ke /data
DATA_DIR=/data

# Opsional: meneruskan balasan masuk (STOP/BERHENTI) ke aplikasi untuk fitur Anti Ban
# APP_INBOUND_URL=https://DOMAIN-APLIKASI-KAMU/api/public/wa/inbound
# WA_CRON_SECRET=samakan-dengan-WA_CRON_SECRET-di-aplikasi

# Engine yang dilaporkan ke aplikasi. Biarkan NOWEB supaya aplikasi mau mengirim gambar + tombol sekaligus.
REPORT_ENGINE=NOWEB

# 1 = sertakan node <bot> pada pesan bertombol (konfigurasi yang terbukti tampil di uji kamu, tapi ada label "AI").
# Set 0 kalau hasil uji NOBOT=1 menunjukkan tombol tetap tampil tanpa label AI.
BUTTON_BOT_NODE=1

# 1 = bungkus pesan bertombol dengan viewOnceMessage (hanya kalau tombol tidak tampil)
BUTTON_WRAP=0

# silent | error | warn | info | debug
LOG_LEVEL=warn
